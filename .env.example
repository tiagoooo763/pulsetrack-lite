# ==============================================================================
# Dashfy — Variáveis de Ambiente (.env.local / Vercel)
# ==============================================================================

# 1. Supabase Auth (mesmo projeto Supabase já conectado ao banco)
NEXT_PUBLIC_SUPABASE_URL=https://xtdumjninvilhirpplkv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publica_anon_do_supabase

# 2. URL Pública da Aplicação (usada em e-mails de confirmação e recuperação)
NEXT_PUBLIC_APP_URL=https://www.usedashfy.com.br

# 3. Banco de Dados PostgreSQL (Supabase Pooler em produção) ou SQLite local
DATABASE_URL=file:./data/pulsetrack.db
DATABASE_AUTH_TOKEN=

# 4. Compatibilidade legada (conta proprietária inicial — opcional)
DASHBOARD_USER=mendoncat831@gmail.com
DASHBOARD_PASSWORD=
AUTH_SECRET=

# 5. Integração OmegaPay (fallback opcional da conta proprietária; cada usuário também configura isolado no banco)
OMEGAPAY_API_BASE_URL=https://app.omegapayments.com.br/api/v1
OMEGAPAY_PUBLIC_KEY=
OMEGAPAY_SECRET_KEY=
OMEGAPAY_WEBHOOK_TOKEN=

# 6. Integração OAuth TikTok Marketing API (SOMENTE BACKEND — nunca usar prefixo NEXT_PUBLIC_)
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=https://www.usedashfy.com.br/api/integrations/tiktok/callback
# Chave hexadecimal de 64 caracteres (32 bytes) para criptografia AES-256-GCM dos tokens no banco
TIKTOK_TOKEN_ENCRYPTION_KEY=
