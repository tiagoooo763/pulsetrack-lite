# ==========================================
# PulseTrack Lite — Variáveis de Ambiente
# ==========================================

# 1. Autenticação do Painel PulseTrack Lite (exclusivo no servidor)
DASHBOARD_USER="admin"
DASHBOARD_PASSWORD="change-me-strong-password"
AUTH_SECRET="gere-um-segredo-aleatorio-de-pelo-menos-32-caracteres"

# 2. Credenciais Oficiais da API OmegaPay (exclusivas no servidor)
# URL Base oficial: https://app.omegapayments.com.br/api/v1
OMEGAPAY_API_BASE_URL="https://app.omegapayments.com.br/api/v1"
OMEGAPAY_PUBLIC_KEY="sua_x_public_key_aqui"
OMEGAPAY_SECRET_KEY="sua_x_secret_key_aqui"

# 3. Token de Validação de Webhook da OmegaPay
# Copie o token gerado em Configurações > Webhooks ao criar o webhook no painel da OmegaPay.
# Caso cadastre mais de um webhook (ex.: um para Pagamentos e outro para Transferências),
# você pode separar múltiplos tokens por vírgula: "token_pagamentos,token_transferencias"
OMEGAPAY_WEBHOOK_TOKEN="seu_token_de_validacao_webhook_aqui"

# 4. Banco de Dados Persistente (Plano Gratuito)
# - Local (padrão automático): file:./data/pulsetrack.db (SQLite / LibSQL persistente em disco)
# - Turso Cloud (Gratuito): libsql://seu-banco.turso.io
# - Neon / Supabase PostgreSQL (Gratuito): postgresql://usuario:senha@host/dbname?sslmode=require
DATABASE_URL="file:./data/pulsetrack.db"
DATABASE_AUTH_TOKEN=""
